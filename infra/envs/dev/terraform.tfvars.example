# Copy to terraform.tfvars (gitignored) and fill in before `terraform apply`.

aws_region   = "us-east-1"
project_name = "mmc"
environment  = "dev"

# Leave empty to use CloudFront's default domain (see specs/01-architecture.md).
domain_name        = ""
create_hosted_zone = false

admin_emails     = "you@example.com"
google_client_id = ""
facebook_app_id  = ""

# Leave empty to skip SES entirely (no donor-onboarding emails sent).
# Remember: SES starts in sandbox mode — recipients need verifying too
# until AWS grants production access. See
# specs/features/007-donor-application-approval/design.md.
ses_from_email = ""

# Put these in a separate gitignored *.auto.tfvars file instead (e.g.
# secrets.auto.tfvars) rather than here, so they're never accidentally
# committed alongside non-secret config:
# facebook_app_secret = ""
# session_secret      = ""
