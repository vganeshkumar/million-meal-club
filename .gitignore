.DS_*

# frontend (Next.js)
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env*
!frontend/.env.example

# backend (Python)
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/*.pyc
backend/.pytest_cache/

# infra (Terraform) — see infra/.gitignore for details
infra/**/.terraform/*
infra/**/*.tfstate*
infra/**/*.tfvars
infra/**/*.auto.tfvars
!infra/**/*.tfvars.example
